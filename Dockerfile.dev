FROM node:20
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOST=0.0.0.0
ENV PORT=3000
# Default API endpoint for local development; can be overridden at runtime.
ARG NEXT_PUBLIC_TTS_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_TTS_API_URL=${NEXT_PUBLIC_TTS_API_URL}

# Install dependencies into the image; bind mounts will overlay source, while
# node_modules lives on a named volume mounted at runtime.
COPY package*.json ./
RUN npm ci

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
